{
  "name": "ogacode",
  "displayName": "OgaCode",
  "description": "AI coding assistant for Nigerian developers — optimized for 3G and 8GB RAM",
  "version": "0.0.1",
  "publisher": "ogacode",
  "engines": { "vscode": "^1.85.0" },
  "icon": "icon.png",
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "OgaCode",
      "properties": {
        "ogacode.serverUrl": {
          "type": "string",
          "default": "https://ogacode-production.up.railway.app",
          "description": "OgaCode server URL. When set, personal API keys are not required — the server holds them."
        },
        "ogacode.token": {
          "type": "string",
          "default": "",
          "description": "Your OgaCode access token (required when ogacode.serverUrl is set)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ogacode-sidebar",
          "title": "OgaCode",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ogacode-sidebar": [
        {
          "type": "webview",
          "id": "ogacode.sidebar",
          "name": "OgaCode Assistant"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/macsamuel123/OgaCode.git"
  },
  "scripts": {
    "build": "node esbuild.cjs",
    "build:prod": "node esbuild.cjs --production",
    "watch": "node esbuild.cjs --watch",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.cjs",
    "package": "node scripts/validate.cjs && node esbuild.cjs --production && npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
