{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-extension",
      "type": "shell",
      "command": "node esbuild.cjs",
      "options": {
        "cwd": "${workspaceFolder}/extension"
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "watch-extension",
      "type": "shell",
      "command": "node esbuild.cjs --watch",
      "options": {
        "cwd": "${workspaceFolder}/extension"
      },
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
